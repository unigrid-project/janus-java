<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC "-//Checkstyle//DTD SuppressionXpathFilter Experimental Configuration 1.2//EN"
                              "https://checkstyle.org/dtds/suppressions_1_2_xpath_experimental.dtd">
<suppressions>
	<suppress-xpath checks="EmptyLineSeparator"
	                query="//INTERFACE_DEF//METHOD_DEF" />
	<suppress-xpath checks="Indentation"
	                query="//PLUS[./STRING_LITERAL]/.." />
	<suppress-xpath checks="Indentation"
	                query="//PLUS[./STRING_LITERAL]" />
	<!-- Java 17 has no public way to release a mapped file, which Windows keeps locked until it is. -->
	<suppress-xpath checks="IllegalImport"
	                files="BerkeleyFile\.java" />
</suppressions>
