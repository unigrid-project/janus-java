<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.unigrid.janus</groupId>
		<artifactId>parent</artifactId>
		<version>2.0.1-SNAPSHOT</version>
	</parent>
	<artifactId>desktop</artifactId>
	<packaging>jar</packaging>
	<name>Unigrid Janus Desktop Application</name>
	<description>Native installers: the application, its Java runtime and its browser engine in one package.</description>
	<properties>
		<mainClass>org.unigrid.janus.shell.Janus</mainClass>
		<input>${project.build.directory}/input</input>
		<dist>${project.build.directory}/dist</dist>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.unigrid.janus</groupId>
			<artifactId>shell</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>me.friwi</groupId>
			<artifactId>jcefmaven</artifactId>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
		</dependency>
		<dependency>
			<groupId>com.microsoft.playwright</groupId>
			<artifactId>playwright</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>
	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-checkstyle-plugin</artifactId>
			</plugin>
			<plugin>
				<!-- Everything in the input folder goes on the application's classpath, so jars left over
				     from another version would be loaded next to the new ones. -->
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-clean-plugin</artifactId>
				<version>3.3.2</version>
				<executions>
					<execution>
						<id>stale-jars</id>
						<phase>generate-resources</phase>
						<goals>
							<goal>clean</goal>
						</goals>
						<configuration>
							<excludeDefaultDirectories>true</excludeDefaultDirectories>
							<filesets>
								<fileset>
									<directory>${input}</directory>
									<includes>
										<include>*.jar</include>
									</includes>
								</fileset>
							</filesets>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>build-helper-maven-plugin</artifactId>
				<version>3.6.0</version>
				<executions>
					<execution>
						<id>installer-version</id>
						<phase>initialize</phase>
						<goals>
							<goal>parse-version</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<version>3.8.1</version>
				<executions>
					<execution>
						<id>application-jars</id>
						<phase>prepare-package</phase>
						<goals>
							<goal>copy-dependencies</goal>
						</goals>
						<configuration>
							<includeScope>runtime</includeScope>
							<outputDirectory>${input}</outputDirectory>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>exec-maven-plugin</artifactId>
				<executions>
					<execution>
						<id>browser-engine</id>
						<phase>prepare-package</phase>
						<goals>
							<goal>java</goal>
						</goals>
						<configuration>
							<mainClass>org.unigrid.janus.desktop.PrepareCef</mainClass>
							<arguments>
								<argument>${input}/jcef</argument>
							</arguments>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.panteleyev</groupId>
				<artifactId>jpackage-maven-plugin</artifactId>
				<version>1.8.0</version>
				<configuration>
					<name>Unigrid</name>
					<vendor>Stiftelsen The Unigrid Foundation</vendor>
					<description>The Unigrid Control Center: a desktop frontend to the Hedgehog network and the Unigrid network.</description>
					<copyright>Copyright © 2021-2026 Stiftelsen The Unigrid Foundation</copyright>					<!-- Installers take a plain number, which a snapshot is not. -->
					<appVersion>${parsedVersion.majorVersion}.${parsedVersion.minorVersion}.${parsedVersion.incrementalVersion}</appVersion>
					<destination>${dist}</destination>
				</configuration>
				<executions>
					<execution>
						<id>appimage</id>
						<phase>package</phase>
						<goals>
							<goal>jpackage</goal>
						</goals>
						<configuration>
							<type>APP_IMAGE</type>
							<removeDestination>true</removeDestination>
							<input>${input}</input>
							<mainJar>shell-${project.version}.jar</mainJar>
							<mainClass>${mainClass}</mainClass>
							<winConsole>false</winConsole>
							<addModules>
								<addModule>java.base</addModule>
								<addModule>java.desktop</addModule>
								<addModule>java.instrument</addModule>
								<addModule>java.management</addModule>
								<addModule>java.naming</addModule>
								<addModule>java.net.http</addModule>
								<addModule>java.sql</addModule>
								<!-- jdeps cannot see modules that are found through service lookup: the window
								     toolkit loads jdk.accessibility for screen readers, and Jetty reads its
								     stylesheets out of the jar through jdk.zipfs. -->
								<addModule>jdk.accessibility</addModule>
								<addModule>jdk.unsupported</addModule>
								<addModule>jdk.zipfs</addModule>
							</addModules>
							<jLinkOptions>
								<jLinkOption>--strip-debug</jLinkOption>
								<jLinkOption>--no-man-pages</jLinkOption>
								<jLinkOption>--no-header-files</jLinkOption>
								<jLinkOption>--compress=zip-6</jLinkOption>
							</jLinkOptions>
							<javaOptions>
								<option>--add-opens</option>
								<option>java.base/java.lang=ALL-UNNAMED</option>
								<option>--enable-native-access=ALL-UNNAMED</option>
								<option>-Djanus.jcef=$APPDIR/jcef</option>
							</javaOptions>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<!-- Runs the installed packages, so they have to exist before the integration phase. -->
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-failsafe-plugin</artifactId>
			</plugin>
		</plugins>
	</build>
	<profiles>
		<profile>
			<id>windows</id>
			<activation>
				<os>
					<family>windows</family>
				</os>
			</activation>
			<build>
				<plugins>
					<plugin>
						<groupId>org.panteleyev</groupId>
						<artifactId>jpackage-maven-plugin</artifactId>
						<executions>
							<execution>
								<id>appimage</id>
								<configuration>
									<icon>${project.basedir}/src/main/packaging/icons/unigrid-256-256.ico</icon>
								</configuration>
							</execution>
							<execution>
								<!-- Built before the integration phase, which installs it. -->
								<id>msi</id>
								<phase>pre-integration-test</phase>
								<goals>
									<goal>jpackage</goal>
								</goals>
								<configuration>
									<type>MSI</type>
									<appImage>${dist}/Unigrid</appImage>
									<licenseFile>${project.basedir}/../COPYING</licenseFile>
									<aboutUrl>https://www.unigrid.org</aboutUrl>
									<winHelpUrl>https://github.com/unigrid-project/janus-java</winHelpUrl>
									<winPerUserInstall>true</winPerUserInstall>
									<winMenu>true</winMenu>
									<winMenuGroup>Unigrid</winMenuGroup>
									<winShortcut>true</winShortcut>
									<winShortcutPrompt>true</winShortcutPrompt>
									<winUpgradeUuid>81b39b16-62e0-46a8-bad8-8bf97d21e19b</winUpgradeUuid>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
		<profile>
			<id>mac</id>
			<activation>
				<os>
					<family>mac</family>
				</os>
			</activation>
			<build>
				<plugins>
					<plugin>
						<groupId>org.panteleyev</groupId>
						<artifactId>jpackage-maven-plugin</artifactId>
						<executions>
							<execution>
								<id>appimage</id>
								<configuration>
									<icon>${project.basedir}/src/main/packaging/icons/unigrid-1024x1024.icns</icon>
									<macPackageIdentifier>org.unigrid.janus</macPackageIdentifier>
									<macPackageName>Unigrid</macPackageName>
									<macAppCategory>utilities</macAppCategory>
									<javaOptions>
										<option>--add-opens</option>
										<option>java.base/java.lang=ALL-UNNAMED</option>
										<option>--add-exports</option>
										<option>java.desktop/sun.awt=ALL-UNNAMED</option>
										<option>--add-exports</option>
										<option>java.desktop/sun.lwawt=ALL-UNNAMED</option>
										<option>--add-exports</option>
										<option>java.desktop/sun.lwawt.macosx=ALL-UNNAMED</option>
										<option>--enable-native-access=ALL-UNNAMED</option>
										<option>-Djanus.jcef=$APPDIR/jcef</option>
									</javaOptions>
								</configuration>
							</execution>
							<execution>
								<!-- Built before the integration phase, which installs it. -->
								<id>dmg</id>
								<phase>pre-integration-test</phase>
								<goals>
									<goal>jpackage</goal>
								</goals>
								<configuration>
									<type>DMG</type>
									<appImage>${dist}/Unigrid.app</appImage>
									<macPackageIdentifier>org.unigrid.janus</macPackageIdentifier>
									<macPackageName>Unigrid</macPackageName>
								</configuration>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.codehaus.mojo</groupId>
						<artifactId>exec-maven-plugin</artifactId>
						<executions>
							<execution>
								<!-- Apple Silicon refuses to run native code that carries no signature at all. No
								     certificate is available, so the bundle gets an ad-hoc one, after the image is
								     built and before the disk image wraps it. -->
								<id>ad-hoc-signature</id>
								<phase>pre-integration-test</phase>
								<goals>
									<goal>exec</goal>
								</goals>
								<configuration>
									<executable>codesign</executable>
									<arguments>
										<argument>--force</argument>
										<argument>--deep</argument>
										<argument>--sign</argument>
										<argument>-</argument>
										<argument>${dist}/Unigrid.app</argument>
									</arguments>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
		<profile>
			<id>linux</id>
			<activation>
				<os>
					<name>linux</name>
				</os>
			</activation>
			<build>
				<plugins>
					<plugin>
						<groupId>org.panteleyev</groupId>
						<artifactId>jpackage-maven-plugin</artifactId>
						<executions>
							<execution>
								<id>appimage</id>
								<configuration>
									<icon>${project.basedir}/src/main/packaging/icons/unigrid-1024x1024.png</icon>
								</configuration>
							</execution>
							<execution>
								<id>deb</id>
								<phase>package</phase>
								<goals>
									<goal>jpackage</goal>
								</goals>
								<configuration>
									<type>DEB</type>
									<appImage>${dist}/Unigrid</appImage>
									<licenseFile>${project.basedir}/../COPYING</licenseFile>
									<resourceDir>${project.basedir}/src/main/packaging/linux</resourceDir>
									<linuxPackageName>unigrid</linuxPackageName>
									<linuxAppCategory>net</linuxAppCategory>
									<linuxMenuGroup>Network</linuxMenuGroup>
									<linuxShortcut>true</linuxShortcut>
									<icon>${project.basedir}/src/main/packaging/icons/unigrid-1024x1024.png</icon>
									<!-- The control file in the resource folder names the dependencies itself. Those
									     jpackage finds are the exact packages of the computer that builds, and the
									     libraries renamed since, such as Ubuntu 24.04's t64 ones and libunistring5,
									     would make the package impossible to install on newer releases. The t64 names
									     come first: on Ubuntu 24.04 the old name libasound2 is only provided by an OSS
									     shim that lacks symbols the browser engine needs. -->
									<linuxDebMaintainer>info@unigridfoundation.se</linuxDebMaintainer>
								</configuration>
							</execution>
							<execution>
								<id>rpm</id>
								<phase>package</phase>
								<goals>
									<goal>jpackage</goal>
								</goals>
								<configuration>
									<type>RPM</type>
									<appImage>${dist}/Unigrid</appImage>
									<licenseFile>${project.basedir}/../COPYING</licenseFile>
									<resourceDir>${project.basedir}/src/main/packaging/linux</resourceDir>
									<linuxPackageName>unigrid</linuxPackageName>
									<linuxAppCategory>Applications/Internet</linuxAppCategory>
									<linuxMenuGroup>Network</linuxMenuGroup>
									<linuxShortcut>true</linuxShortcut>
									<icon>${project.basedir}/src/main/packaging/icons/unigrid-1024x1024.png</icon>
									<linuxPackageDeps>nss, mesa-libgbm, gtk3, alsa-lib, libXScrnSaver, libXtst, libXi, cups-libs, at-spi2-atk, libxkbcommon, libX11</linuxPackageDeps>
									<linuxRpmLicenseType>AGPLv3+</linuxRpmLicenseType>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
</project>
