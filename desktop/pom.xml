<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.unigrid.janus</groupId>
		<artifactId>parent</artifactId>
		<version>2.0.0-SNAPSHOT</version>
	</parent>
	<artifactId>desktop</artifactId>
	<packaging>jar</packaging>
	<name>Unigrid Janus Desktop Application</name>
	<description>Native installers: the application, its Java runtime and its browser engine in one package.</description>
	<properties>
		<mainClass>org.unigrid.janus.shell.Janus</mainClass>
		<input>${project.build.directory}/input</input>
		<dist>${project.build.directory}/dist</dist>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.unigrid.janus</groupId>
			<artifactId>shell</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>me.friwi</groupId>
			<artifactId>jcefmaven</artifactId>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
		</dependency>
	</dependencies>
	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-checkstyle-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>build-helper-maven-plugin</artifactId>
				<version>3.6.0</version>
				<executions>
					<execution>
						<id>installer-version</id>
						<phase>initialize</phase>
						<goals>
							<goal>parse-version</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<version>3.8.1</version>
				<executions>
					<execution>
						<id>application-jars</id>
						<phase>prepare-package</phase>
						<goals>
							<goal>copy-dependencies</goal>
						</goals>
						<configuration>
							<includeScope>runtime</includeScope>
							<outputDirectory>${input}</outputDirectory>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>exec-maven-plugin</artifactId>
				<executions>
					<execution>
						<id>browser-engine</id>
						<phase>prepare-package</phase>
						<goals>
							<goal>java</goal>
						</goals>
						<configuration>
							<mainClass>org.unigrid.janus.desktop.PrepareCef</mainClass>
							<arguments>
								<argument>${input}/jcef</argument>
							</arguments>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.panteleyev</groupId>
				<artifactId>jpackage-maven-plugin</artifactId>
				<version>1.8.0</version>
				<configuration>
					<name>Unigrid</name>
					<vendor>Stiftelsen The Unigrid Foundation</vendor>
					<!-- Installers take a plain number, which a snapshot is not. -->
					<appVersion>${parsedVersion.majorVersion}.${parsedVersion.minorVersion}.${parsedVersion.incrementalVersion}</appVersion>
					<destination>${dist}</destination>
				</configuration>
				<executions>
					<execution>
						<id>appimage</id>
						<phase>package</phase>
						<goals>
							<goal>jpackage</goal>
						</goals>
						<configuration>
							<type>APP_IMAGE</type>
							<removeDestination>true</removeDestination>
							<input>${input}</input>
							<mainJar>shell-${project.version}.jar</mainJar>
							<mainClass>${mainClass}</mainClass>
							<winConsole>false</winConsole>
							<addModules>
								<addModule>java.base</addModule>
								<addModule>java.desktop</addModule>
								<addModule>java.instrument</addModule>
								<addModule>java.management</addModule>
								<addModule>java.naming</addModule>
								<addModule>java.net.http</addModule>
								<addModule>java.sql</addModule>
								<!-- jdeps cannot see modules that are found through service lookup: the window
								     toolkit loads jdk.accessibility for screen readers, TLS needs jdk.crypto.ec,
								     and Jetty reads its stylesheets out of the jar through jdk.zipfs. -->
								<addModule>jdk.accessibility</addModule>
								<addModule>jdk.crypto.ec</addModule>
								<addModule>jdk.unsupported</addModule>
								<addModule>jdk.zipfs</addModule>
							</addModules>
							<jLinkOptions>
								<jLinkOption>--strip-debug</jLinkOption>
								<jLinkOption>--no-man-pages</jLinkOption>
								<jLinkOption>--no-header-files</jLinkOption>
								<jLinkOption>--compress=2</jLinkOption>
							</jLinkOptions>
							<javaOptions>
								<option>--add-opens</option>
								<option>java.base/java.lang=ALL-UNNAMED</option>
								<option>-Djanus.jcef=$APPDIR/jcef</option>
							</javaOptions>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
	<profiles>
		<profile>
			<id>windows</id>
			<activation>
				<os>
					<family>windows</family>
				</os>
			</activation>
			<build>
				<plugins>
					<plugin>
						<groupId>org.panteleyev</groupId>
						<artifactId>jpackage-maven-plugin</artifactId>
						<executions>
							<execution>
								<id>appimage</id>
								<configuration>
									<icon>${project.basedir}/src/main/packaging/icons/unigrid-256-256.ico</icon>
								</configuration>
							</execution>
							<execution>
								<id>msi</id>
								<phase>verify</phase>
								<goals>
									<goal>jpackage</goal>
								</goals>
								<configuration>
									<type>MSI</type>
									<appImage>${dist}/Unigrid</appImage>
									<winPerUserInstall>true</winPerUserInstall>
									<winMenu>true</winMenu>
									<winMenuGroup>Unigrid</winMenuGroup>
									<winShortcut>true</winShortcut>
									<winUpgradeUuid>81b39b16-62e0-46a8-bad8-8bf97d21e19b</winUpgradeUuid>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
		<profile>
			<id>mac</id>
			<activation>
				<os>
					<family>mac</family>
				</os>
			</activation>
			<build>
				<plugins>
					<plugin>
						<groupId>org.panteleyev</groupId>
						<artifactId>jpackage-maven-plugin</artifactId>
						<executions>
							<execution>
								<id>appimage</id>
								<configuration>
									<icon>${project.basedir}/src/main/packaging/icons/unigrid-1024x1024.icns</icon>
									<macPackageIdentifier>org.unigrid.janus</macPackageIdentifier>
									<macPackageName>Unigrid</macPackageName>
									<javaOptions>
										<option>--add-opens</option>
										<option>java.base/java.lang=ALL-UNNAMED</option>
										<option>--add-exports</option>
										<option>java.desktop/sun.awt=ALL-UNNAMED</option>
										<option>--add-exports</option>
										<option>java.desktop/sun.lwawt=ALL-UNNAMED</option>
										<option>--add-exports</option>
										<option>java.desktop/sun.lwawt.macosx=ALL-UNNAMED</option>
										<option>-Djanus.jcef=$APPDIR/jcef</option>
									</javaOptions>
								</configuration>
							</execution>
							<execution>
								<id>dmg</id>
								<phase>verify</phase>
								<goals>
									<goal>jpackage</goal>
								</goals>
								<configuration>
									<type>DMG</type>
									<appImage>${dist}/Unigrid.app</appImage>
									<macPackageIdentifier>org.unigrid.janus</macPackageIdentifier>
									<macPackageName>Unigrid</macPackageName>
								</configuration>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.codehaus.mojo</groupId>
						<artifactId>exec-maven-plugin</artifactId>
						<executions>
							<execution>
								<!-- Apple Silicon refuses to run native code that carries no signature at all. No
								     certificate is available, so the bundle gets an ad-hoc one, after the image is
								     built and before the disk image wraps it. -->
								<id>ad-hoc-signature</id>
								<phase>pre-integration-test</phase>
								<goals>
									<goal>exec</goal>
								</goals>
								<configuration>
									<executable>codesign</executable>
									<arguments>
										<argument>--force</argument>
										<argument>--deep</argument>
										<argument>--sign</argument>
										<argument>-</argument>
										<argument>${dist}/Unigrid.app</argument>
									</arguments>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
		<profile>
			<id>linux</id>
			<activation>
				<os>
					<name>linux</name>
				</os>
			</activation>
			<build>
				<plugins>
					<plugin>
						<groupId>org.panteleyev</groupId>
						<artifactId>jpackage-maven-plugin</artifactId>
						<executions>
							<execution>
								<id>appimage</id>
								<configuration>
									<icon>${project.basedir}/src/main/packaging/icons/unigrid-1024x1024.png</icon>
								</configuration>
							</execution>
							<execution>
								<id>deb</id>
								<phase>package</phase>
								<goals>
									<goal>jpackage</goal>
								</goals>
								<configuration>
									<type>DEB</type>
									<appImage>${dist}/Unigrid</appImage>
									<linuxPackageName>unigrid</linuxPackageName>
									<linuxAppCategory>Utilities</linuxAppCategory>
									<linuxMenuGroup>Utilities</linuxMenuGroup>
									<linuxShortcut>true</linuxShortcut>
									<icon>${project.basedir}/src/main/packaging/icons/unigrid-1024x1024.png</icon>
									<!-- jpackage only finds the libraries that dpkg knows by their real path, and on a
									     merged /usr that misses the ones the browser engine and the window toolkit
									     load, so they are named here. The t64 names are Ubuntu 24.04's. -->
									<linuxPackageDeps>libnss3, libgbm1, libgtk-3-0 | libgtk-3-0t64, libasound2 | libasound2t64, libxss1, libxtst6, libxi6, libcups2 | libcups2t64, libatk-bridge2.0-0 | libatk-bridge2.0-0t64, libxkbcommon0, libx11-6</linuxPackageDeps>
									<linuxDebMaintainer>info@unigridfoundation.se</linuxDebMaintainer>
								</configuration>
							</execution>
							<execution>
								<id>rpm</id>
								<phase>package</phase>
								<goals>
									<goal>jpackage</goal>
								</goals>
								<configuration>
									<type>RPM</type>
									<appImage>${dist}/Unigrid</appImage>
									<linuxPackageName>unigrid</linuxPackageName>
									<linuxAppCategory>Utilities</linuxAppCategory>
									<linuxMenuGroup>Utilities</linuxMenuGroup>
									<linuxShortcut>true</linuxShortcut>
									<icon>${project.basedir}/src/main/packaging/icons/unigrid-1024x1024.png</icon>
									<linuxPackageDeps>nss, mesa-libgbm, gtk3, alsa-lib, libXScrnSaver, libXtst, libXi, cups-libs, at-spi2-atk, libxkbcommon, libX11</linuxPackageDeps>
									<linuxRpmLicenseType>AGPLv3+</linuxRpmLicenseType>
								</configuration>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<!-- Runs the installed packages, so they have to exist before the integration phase. -->
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-failsafe-plugin</artifactId>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
</project>
