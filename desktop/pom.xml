<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.unigrid.janus</groupId>
		<artifactId>parent</artifactId>
		<version>1.0.12</version>
	</parent>
	<artifactId>desktop</artifactId>
	<packaging>jar</packaging>
	<name>Unigrid Janus Desktop Application</name>
	<description>Native installers: the application, its Java runtime and its browser engine in one package.</description>
	<properties>
		<mainClass>org.unigrid.janus.shell.Janus</mainClass>
		<input>${project.build.directory}/input</input>
		<dist>${project.build.directory}/dist</dist>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.unigrid.janus</groupId>
			<artifactId>shell</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>me.friwi</groupId>
			<artifactId>jcefmaven</artifactId>
		</dependency>
	</dependencies>
	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-checkstyle-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<version>3.8.1</version>
				<executions>
					<execution>
						<id>application-jars</id>
						<phase>prepare-package</phase>
						<goals>
							<goal>copy-dependencies</goal>
						</goals>
						<configuration>
							<includeScope>runtime</includeScope>
							<outputDirectory>${input}</outputDirectory>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>exec-maven-plugin</artifactId>
				<executions>
					<execution>
						<id>browser-engine</id>
						<phase>prepare-package</phase>
						<goals>
							<goal>java</goal>
						</goals>
						<configuration>
							<mainClass>org.unigrid.janus.desktop.PrepareCef</mainClass>
							<arguments>
								<argument>${input}/jcef</argument>
							</arguments>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.panteleyev</groupId>
				<artifactId>jpackage-maven-plugin</artifactId>
				<version>1.8.0</version>
				<configuration>
					<name>Unigrid</name>
					<vendor>Stiftelsen The Unigrid Foundation</vendor>
					<appVersion>${project.version}</appVersion>
					<destination>${dist}</destination>
				</configuration>
				<executions>
					<execution>
						<id>appimage</id>
						<phase>package</phase>
						<goals>
							<goal>jpackage</goal>
						</goals>
						<configuration>
							<type>APP_IMAGE</type>
							<removeDestination>true</removeDestination>
							<input>${input}</input>
							<mainJar>shell-${project.version}.jar</mainJar>
							<mainClass>${mainClass}</mainClass>
							<winConsole>false</winConsole>
							<addModules>
								<addModule>java.base</addModule>
								<addModule>java.desktop</addModule>
								<addModule>java.instrument</addModule>
								<addModule>java.management</addModule>
								<addModule>java.naming</addModule>
								<addModule>java.net.http</addModule>
								<addModule>java.sql</addModule>
								<addModule>jdk.attach</addModule>
								<addModule>jdk.compiler</addModule>
								<addModule>jdk.crypto.ec</addModule>
								<addModule>jdk.jdi</addModule>
								<addModule>jdk.unsupported</addModule>
							</addModules>
							<jLinkOptions>
								<jLinkOption>--strip-debug</jLinkOption>
								<jLinkOption>--no-man-pages</jLinkOption>
								<jLinkOption>--no-header-files</jLinkOption>
								<jLinkOption>--compress=2</jLinkOption>
							</jLinkOptions>
							<javaOptions>
								<option>--add-opens</option>
								<option>java.base/java.lang=ALL-UNNAMED</option>
								<option>-Djanus.jcef=$APPDIR/jcef</option>
							</javaOptions>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
