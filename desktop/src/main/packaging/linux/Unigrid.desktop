[Desktop Entry]
Name=APPLICATION_NAME
GenericName=Control Center
Comment=APPLICATION_DESCRIPTION
Exec=APPLICATION_LAUNCHER
Icon=APPLICATION_ICON
Terminal=false
Type=Application
Categories=Network;
Keywords=Unigrid;Hedgehog;wallet;cryptocurrency;blockchain;
# The class the window toolkit gives the window of the Janus main class, which is how a dock matches the
# running window to this entry, to pin it and to group its windows.
StartupWMClass=org-unigrid-janus-shell-Janus
DESKTOP_MIMES
